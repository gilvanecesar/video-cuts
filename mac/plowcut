def srt_time(t):
    h, r = divmod(max(t, 0), 3600); m, sec = divmod(r, 60)
    return f"{int(h):02d}:{int(m):02d}:{int(sec):02d},{int(round((sec % 1) * 1000)):03d}"


def parse_srt(path):
    """[(start_s, end_s, text)] — enough for our own re-emit, not a full parser."""
    out, block = [], []
    for line in Path(path).read_text(encoding="utf8", errors="replace").splitlines() + [""]:
        if line.strip() == "":
            if len(block) >= 2 and "-->" in block[1]:
                a, b = block[1].split("-->")
                out.append((to_s(a), to_s(b), "\n".join(block[2:]).strip()))
            block = []
        else:
            block.append(line)
    return out


def to_s(stamp):
    stamp = stamp.strip().replace(",", ".")
    h, m, s = stamp.split(":")
    return int(h) * 3600 + int(m) * 60 + float(s)


# name -> (width, height, framing filter). Vertical is a centre crop, which is
# right for one person facing the camera and wrong for two people side by side;
# that is a known limit, not an oversight.
def autoframe(src, start, end, samples=5):
    """Where the 9:16 window should sit, from the faces actually in the shot.

    Samples a few frames across the moment and takes the median face centre.
    Median, not mean: one false positive on a poster or a reflection should not
    drag the framing. Returns None when nothing is found, and the caller falls
    back to centre — which is a guess, and says so."""
    finder = HOME / "bin" / "facefind"
    if not finder.exists():
        return None
    tmp = HOME / "work" / ".frames"
    tmp.mkdir(parents=True, exist_ok=True)
    shots = []
    for k in range(samples):
        t = start + (end - start) * (k + 0.5) / samples
        f = tmp / f"f{k}.png"
        try:
            subprocess.run([ffbin(), "-nostdin", "-v", "error", "-y", "-ss", f"{t}",
                            "-i", str(src), "-frames:v", "1", str(f)],
                           check=True, capture_output=True, timeout=120)
            shots.append(str(f))
        except Exception:
            pass
    if not shots:
        return None
    try:
        out = subprocess.run([str(finder), *shots], capture_output=True,
                             text=True, timeout=120).stdout
        results = json.loads(out)
    except Exception:
        return None
    xs = []
    for r in results:
        if r.get("faces"):
            biggest = max(r["faces"], key=lambda b: b["w"] * b["h"])
            xs.append(biggest["x"])
    for f in shots:
        Path(f).unlink(missing_ok=True)
    if not xs:
        return None
    xs.sort()
    return xs[len(xs) // 2]


def framing(fmt, x=0.5):
    """`x` is where the 9:16 window sits horizontally, 0 = left, 1 = right.

    A centre crop is right for one person facing the camera and wrong whenever
    they are not centred — which is most real footage."""
    if fmt == "vertical":
        return (1080, 1920,
                f"crop=ih*9/16:ih:(iw-ih*9/16)*{x:.3f}:0,scale=1080:1920")
    if fmt == "square":
        return (1080, 1080, f"crop=ih:ih:(iw-ih)*{x:.3f}:0,scale=1080:1080")
    return FORMATS[fmt]


FORMATS = {
    "vertical":   (1080, 1920, "crop=ih*9/16:ih,scale=1080:1920"),
    "horizontal": (1920, 1080, "scale=1920:1080:force_original_aspect_ratio=decrease,"
                               "pad=1920:1080:(ow-iw)/2:(oh-ih)/2"),
    "square":     (1080, 1080, "crop=ih:ih,scale=1080:1080"),
}

FPS = 30

_FF = {}


def ffbin():
    """An ffmpeg that can render text.

    Homebrew's plain `ffmpeg` formula ships without libass or freetype, so
    `drawtext`, `subtitles` and `ass` simply do not exist in it — and the
    failure reads like a filtergraph syntax error, not a missing feature.
    `ffmpeg-full` has them but installs keg-only, off PATH. Look for a capable
    binary instead of trusting whichever one PATH happens to hand us."""
    if "bin" in _FF:
        return _FF["bin"]
    candidates = [config().get("ffmpeg"),
                  "/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg",
                  "/usr/local/opt/ffmpeg-full/bin/ffmpeg", "ffmpeg"]
    plain = None
    for c in candidates:
        if not c:
            continue
        try:
            out = subprocess.run([c, "-hide_banner", "-filters"],
                                 capture_output=True, text=True, timeout=30).stdout
        except Exception:
            continue
        plain = plain or c
        if " subtitles " in out:
            _FF["bin"] = c
            return c
    _FF["bin"] = plain or "ffmpeg"
    return _FF["bin"]


def probebin():
    """The ffprobe that belongs to the chosen ffmpeg.

    Installing ffmpeg-full moved x265, which left the plain formula's ffprobe
    unable to load libx265 — so the one on PATH may be broken even though a
    working one is right next to the ffmpeg we picked."""
    b = ffbin()
    sib = str(Path(b).with_name("ffprobe")) if "/" in b else "ffprobe"
    try:
        if subprocess.run([sib, "-version"], capture_output=True,
                          timeout=15).returncode == 0:
            return sib
    except Exception:
        pass
    return "ffprobe"


def can_caption():
    return " subtitles " in subprocess.run(
        [ffbin(), "-hide_banner", "-filters"],
        capture_output=True, text=True).stdout


ASS_HEAD = """[Script Info]
ScriptType: v4.00+
PlayResX: {w}
PlayResY: {h}
WrapStyle: 2
ScaledBorderAndShadow: yes

[V4+ Styles]
Format: Name,Fontname,Fontsize,PrimaryColour,SecondaryColour,OutlineColour,BackColour,Bold,Italic,Underline,StrikeOut,ScaleX,ScaleY,Spacing,Angle,BorderStyle,Outline,Shadow,Alignment,MarginL,MarginR,MarginV,Encoding
Style: D,Helvetica,{size},&H00FFFFFF,&H00FFFFFF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,{outline},0,2,{margin},{margin},{mv},1
Style: K,Helvetica,{ksize},&H0000E5FF,&H0000E5FF,&H00000000,&H00000000,-1,0,0,0,100,100,2,0,1,{koutline},0,8,{margin},{margin},{kmv},1

[Events]
Format: Layer,Start,End,Style,Name,MarginL,MarginR,MarginV,Effect,Text
"""


def ass_t(t):
    t = max(t, 0); h, r = divmod(t, 3600); m, sec = divmod(r, 60)
    return f"{int(h)}:{int(m):02d}:{int(sec):02d}.{int(round((sec % 1) * 100)):02d}"


def caption_ass(ws, start, end, dest, w, h, per_line=3, hi="&H0000E5FF&",
                keywords=None):
    """Word-by-word captions: a few words on screen, the spoken one lit.

    We already have a timestamp per word — it is what places the hook — so the
    caption everyone recognises from short-form costs us nothing extra."""
    inside = [(t, x) for t, x in ws if start <= t < end]
    if not inside:
        return 0
    size = int(h * 0.046)
    lines, n = [], 0
    for g in range(0, len(inside), per_line):
        group = inside[g:g + per_line]
        gend = inside[g + per_line][0] if g + per_line < len(inside) else end
        for i, (t, _) in enumerate(group):
            nxt = group[i + 1][0] if i + 1 < len(group) else gend
            plain = " ".join(x for _, x in group)
            body = " ".join(
                (f"{{\\c{hi}}}{x}{{\\c&H00FFFFFF&}}" if j == i else x)
                for j, (_, x) in enumerate(group))
            # Same overflow as the keywords: WrapStyle 2 never wraps, it just
            # runs off both edges. Shrink the line rather than break it — one
            # line is what short-form reads.
            fit = int((w * 0.88) / max(1, len(plain) * 0.47))
            fs = max(int(h * 0.028), min(size, fit))
            lines.append(f"Dialogue: 0,{ass_t(t - start)},{ass_t(nxt - start)},"
                         f"D,,0,0,0,,{{\\fs{fs}}}{body}")
            n += 1
    ksize = int(h * 0.075)
    for k in keywords or []:
        at = float(k["at"])
        if not (start <= at < end):
            continue
        text = str(k["text"])
        a, b = at - start, min(at - start + 1.9, end - start)
        # Long words overflow a fixed size and get sliced by the frame edge.
        # Helvetica Bold caps run about 0.60 em wide; shrink to fit the margins.
        fit = int((w * 0.86) / max(1, len(text) * 0.60))
        size = max(int(h * 0.030), min(ksize, fit))
        # pop: lands 18% oversized and settles; short fade at both ends.
        fx = (r"{\fs" + str(size) + r"\fad(90,160)"
              r"\t(0,130,\fscx118\fscy118)\t(130,260,\fscx100\fscy100)}")
        lines.append(f"Dialogue: 1,{ass_t(a)},{ass_t(b)},K,,0,0,0,,{fx}{text}")
        n += 1

    head = ASS_HEAD.format(w=w, h=h, size=size, outline=max(2, size // 14),
                           ksize=int(h * 0.075), koutline=max(3, int(h * 0.075) // 12),
                           margin=int(w * 0.10), mv=int(h * 0.13), kmv=int(h * 0.16))
    Path(dest).write_text(head + "\n".join(lines) + "\n", encoding="utf8")
    return n


STOP = set("""a o e de da do das dos que em um uma uns umas na no nas nos por para
com sem se ao aos as os eu voce vc ele ela nos eles elas meu minha seu sua isso
isto esse essa este esta aquele aquela ja mais muito muita tambem so nao sim
como quando onde porque pois mas entao ai la ca ta tao ser estar ter fazer
foi era sao esta estao tem tinha vai vou pra pro né então""".split())


def pick_keywords(ws, start, end, want=2, min_len=6):
    """Words worth putting on screen, and exactly when they are said.

    This is the effect that reads as a real edit rather than a caption: the word
    lands on the frame at the instant it leaves the mouth. We can do it because
    the transcript is already word-by-word — the same data that places the hook.
    The agent may name these in the plan; this is the fallback."""
    inside = [(t, x) for t, x in ws if start + 0.6 <= t < end - 1.2]
    scored = []
    for t, raw in inside:
        w = "".join(c for c in raw if c.isalnum() or c in "-áéíóúâêôãõçÁÉÍÓÚÂÊÔÃÕÇ")
        if len(w) < min_len or norm(w) in STOP:
            continue
        scored.append((len(w), t, w))
    scored.sort(reverse=True)
    picked, used = [], []
    for _, t, w in scored:
        if any(abs(t - u) < 4.0 for u in used):
            continue
        picked.append({"text": w.upper(), "at": t}); used.append(t)
        if len(picked) >= want:
            break
    return sorted(picked, key=lambda k: k["at"])


def norm(t):
    import unicodedata
    t = unicodedata.normalize("NFD", t.lower())
    return " ".join("".join(c for c in t if c.isalnum() or c.isspace()).split())


def snap(ws, hook_text, hint, window=90):
    """Start time of `hook_text` in the word stream, searched around `hint`.

    The agent quotes the line the clip should open on; this finds the word it
    starts at. Without it the clip opens wherever Whisper drew a boundary, and
    a clip that opens on ten seconds of preamble has already lost the viewer."""
    want = norm(hook_text).split()
    if not want:
        return None
    near = [(i, t) for i, (t, _) in enumerate(ws) if abs(t - hint) <= window]
    for i, t in near:
        got = norm(" ".join(w for _, w in ws[i:i + len(want) + 4])).split()
        if got[:len(want)] == want:
            return t
    return None


def cut():
    """Cut the clips named in ~/.dailies/plan.json.

    The plan is a FILE, not arguments: the agent writes it with plow_write_file
    at this fixed path, then calls `plowcut cut`. That keeps the argv identical
    on every run, which is what makes one Latch approval last.

    plan.json:
      {"source": "<stem of the transcribed recording>",
       "clips": [{"title": "...", "start": 123.4, "end": 168.0}]}
    """
    c = config()
    plan_path = HOME / "plan.json"
    if not plan_path.exists():
        return {"error": "no plan", "expected": str(plan_path)}
    plan = json.loads(plan_path.read_text())

    work = Path(c["work"]) / plan["source"]
    src = next((f for f in Path(c["intake"]).iterdir()
                if f.stem == plan["source"] and not f.name.startswith(".")), None)
    if not src:
        return {"error": f"source recording not found for stem {plan['source']!r}"}

    outdir = work / "clips"; outdir.mkdir(parents=True, exist_ok=True)
    ws = words(work)

    captions = can_caption()
    if not captions:
        note("this ffmpeg cannot render text — cutting without captions "
             "(brew install ffmpeg-full)")
    made = []
    for i, clip in enumerate(plan.get("clips", []), 1):
        start, end = float(clip["start"]), float(clip["end"])
        hook = clip.get("hook_text")
        if hook:
            at = snap(ws, hook, start)
            if at is None:
                note(f"  hook not found in the audio: {hook!r} — keeping {start}s")
            else:
                if abs(at - start) > 0.05:
                    note(f"  hook snapped {start:.1f}s → {at:.1f}s")
                start = at
        slug = "".join(ch if ch.isalnum() else "-" for ch in clip.get("title", f"clip{i}")).strip("-").lower()[:60]
        note(f"cutting {i}/{len(plan['clips'])}: {clip.get('title','')} [{start:.0f}s-{end:.0f}s]")

        crop_x = c["crop_x"]
        if crop_x == "auto":
            fx = autoframe(src, start, end)
            if fx is None:
                crop_x = 0.5
                note("  no face found — framing centred, which may be wrong")
            else:
                # The 9:16 window is (h/w)*(9/16) of the source WIDTH — not 9/16,
                # which is the aspect ratio, not a fraction of anything here.
                size = probe_size(src) or (16, 9)
                cw = min(1.0, (size[1] / size[0]) * (9 / 16))
                span = max(1e-6, 1 - cw)
                crop_x = min(1.0, max(0.0, (fx - cw / 2) / span))
                note(f"  face at x={fx:.3f} → crop_x={crop_x:.3f}")
        crop_x = float(crop_x)

        made_here = []
        for fmt in c["formats"]:
            w, h, frame = framing(fmt, crop_x)
            dest = outdir / (f"{i:02d}-{slug}.mp4" if fmt == c["formats"][0]
                             else f"{i:02d}-{slug}-{fmt}.mp4")
            vf = frame
            if c["push_in"]:
                # A slow push toward the speaker. A locked-off talking head goes
                # dead after ten seconds; a drift this small is not noticed, only
                # felt. zoompan wants an fps and an output size or it guesses.
                z = 1 + float(c["push_in"])
                vf += (f",zoompan=z='min(1+{c['push_in']}*on/({FPS}*{max(0.1, end-start):.2f}),{z:.3f})'"
                       f":d=1:x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)'"
                       f":s={w}x{h}:fps={FPS}")
            if captions:
                sub = outdir / f".{i:02d}-{fmt}.ass"
                kws = clip.get("keywords")
                if kws is None:
                    kws = pick_keywords(ws, start, end)
                if caption_ass(ws, start, end, sub, w, h, keywords=kws):
                    vf += f",ass={sub}"
            subprocess.run(
                [ffbin(), "-nostdin", "-y", "-ss", f"{start}", "-to", f"{end}",
                 "-i", str(src), "-vf", vf,
                 "-c:v", "libx264", "-preset", "medium", "-crf", "20",
                 "-c:a", "aac", "-b:a", "160k", "-movflags", "+faststart", str(dest)],
                check=True, capture_output=True)
            made_here.append({"format": fmt, "file": str(dest)})

        made.append({"title": clip.get("title"), "topic": clip.get("topic"),
                     "kind": clip.get("kind"), "start": round(start, 1),
                     "seconds": round(end - start, 1), "renders": made_here})

    note("done")
    return {"cut": len(made), "formats": c["formats"],
            "captions": captions, "clips": made, "folder": str(outdir)}


# --------------------------------------------------------------------------
# transcript / index — what the agent reads and writes back
# --------------------------------------------------------------------------

INDEX = HOME / "topics.json"


def transcript():
    """The newest transcript, line by line with a timestamp on each.

    Kept at Whisper's own granularity on purpose: the agent segments topics by
    reading, but it places `hook_at` on one specific sentence, and no coarser
    index can tell it where that sentence starts."""
    c, st = config(), load(STATE, {})
    seen = st.get("seen", {})
    if not seen:
        return {"error": "nothing transcribed yet"}
    src, meta = max(seen.items(), key=lambda kv: kv[1]["at"])
    work = Path(meta["work"])
    j = work / "transcript.json"
    if not j.exists():
        return {"error": f"transcript missing at {j}"}

    return {"source": Path(src).stem, "duration_s": probe_duration(Path(src)),
            "lines": to_lines(words(work))}


def words(work):
    """[(t, word)] straight from the word-level transcript."""
    raw = json.loads((work / "transcript.json").read_text())
    out = []
    for cue in raw.get("transcription", raw.get("segments", [])):
        off = cue.get("offsets") or {}
        t = (off.get("from", 0) / 1000.0) if off else to_seconds(cue)
        w = (cue.get("text") or "").strip()
        if w:
            out.append((round(t, 2), w))
    return out


def to_lines(ws, max_seconds=15):
    """Words regrouped into readable lines, broken on sentence ends.

    The agent reads these to segment topics; it names the hook by quoting from
    them, and `cut` snaps back to the word. Both views, one transcription."""
    lines, cur = [], None
    for t, w in ws:
        if cur is None:
            cur = {"t": t, "text": w}
        else:
            cur["text"] += " " + w
        if w.endswith((".", "?", "!")) or t - cur["t"] >= max_seconds:
            lines.append(cur); cur = None
    if cur:
        lines.append(cur)
    return lines


def to_seconds(cue):
    v = cue.get("start", 0)
    if isinstance(v, (int, float)):
        return float(v)
    h, m, rest = str(v).split(":")
    return int(h) * 3600 + int(m) * 60 + float(rest.replace(",", "."))


def index():
    """The owner's topic index, accumulated across every recording.

    This is the thing a per-upload clipping tool structurally cannot have: it
    knows the whole library, so a topic that comes back in a later episode joins
    the one that is already there instead of starting over."""
    return load(INDEX, {"topics": {}})


def remember():
    """Fold ~/.dailies/learn.json into the index.

    A file, not arguments — the agent writes it with plow_write_file and calls
    `plowcut remember`, so the argv never changes.

    learn.json: {"source": "<stem>",
                 "topics": [{"topic": "pricing", "range": [380, 1120],
                             "moments": [{"kind": "polemic", "title": "...",
                                          "hook_at": 412.0, "start": 412.0,
                                          "end": 456.0}]}]}
    """
    f = HOME / "learn.json"
    if not f.exists():
        return {"error": "no learn.json", "expected": str(f)}
    incoming, idx = json.loads(f.read_text()), index()
    src = incoming["source"]
    for t in incoming.get("topics", []):
        slot = idx["topics"].setdefault(t["topic"], {"occurrences": []})
        slot["occurrences"] = [o for o in slot["occurrences"] if o.get("source") != src]
        slot["occurrences"].append({"source": src, "range": t.get("range"),
                                    "moments": t.get("moments", []), "at": time.time()})
    save(INDEX, idx)
    return {"topics_known": len(idx["topics"]),
            "revisited": sorted(k for k, v in idx["topics"].items()
                                if len({o["source"] for o in v["occurrences"]}) > 1)}


def status():
    c, st = config(), load(STATE, {})
    return {"intake": c["intake"], "work": c["work"],
            "already_handled": len(st.get("seen", {})),
            "tools": {t: bool(subprocess.run(["which", t], capture_output=True).returncode == 0)
                      for t in ("ffmpeg", "ffprobe", "whisper-cli")}}


CMDS = {"ready": ready, "transcribe": transcribe, "transcript": transcript,
        "index": index, "remember": remember, "cut": cut, "status": status}

if __name__ == "__main__":
    if len(sys.argv) != 2 or sys.argv[1] not in CMDS:
        print(json.dumps({"error": "usage: plowcut {ready|transcribe|transcript|index|remember|cut|status}"}))
        sys.exit(2)
    try:
        print(json.dumps(CMDS[sys.argv[1]](), indent=2))
    except subprocess.CalledProcessError as e:
        print(json.dumps({"error": "command failed",
                          "stderr": (e.stderr or b"")[-800:].decode("utf8", "replace")}))
        sys.exit(1)
