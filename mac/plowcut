#!/usr/bin/env python3
"""plowcut — the Mac-side half of Dailies.

Every subcommand takes NO arguments. That is the whole point: Latch keys a
standing approval on the exact argv, so `plowcut transcribe` must be
byte-identical on every run or the owner gets asked again for each new file.
The variable part — which recording, which clip — lives in state here, never
in the arguments the agent sends.

    plowcut ready       is there a finished recording waiting?
    plowcut transcript  the newest transcript, compacted for reading
    plowcut index       every topic this owner has covered, across recordings
    plowcut remember    fold ~/.dailies/learn.json into that index
    plowcut cut         cut the clips named in ~/.dailies/plan.json
    plowcut transcribe  transcribe the one that is waiting
    plowcut status      what plowcut knows

Output is JSON on stdout. Progress goes to stderr so a long job is never
silent (Latch kills a silent, write-less, network-less command at 15 minutes).
"""
import json, os, re, subprocess, sys, time
from pathlib import Path

HOME = Path(os.environ.get("DAILIES_HOME", Path.home() / ".dailies"))
CONFIG, STATE = HOME / "config.json", HOME / "state.json"
DEFAULT_INTAKE = Path.home() / "Movies" / "Dailies"


def load(p, default):
    try:
        return json.loads(p.read_text())
    except Exception:
        return default


def save(p, obj):
    HOME.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(obj, indent=2))


def config():
    c = load(CONFIG, {})
    c.setdefault("intake", str(DEFAULT_INTAKE))
    c.setdefault("work", str(HOME / "work"))
    c.setdefault("settle_seconds", 90)   # size must hold still this long
    # small.en, not base.en: base garbles roughly a third of a recording, and
    # every topic and moment the agent picks rests on this text. 465MB and
    # ~23x realtime on an M4 is a cheap price for a transcript worth reading.
    c.setdefault("model", str(HOME / "models" / "ggml-small.bin"))
    # "auto" lets whisper detect it. The multilingual model is the default on
    # purpose: an .en model does not merely do worse on other languages, it
    # invents or force-translates, and every topic the agent picks rests on
    # this text.
    c.setdefault("language", "auto")
    c.setdefault("formats", ["vertical", "horizontal"])
    c.setdefault("crop_x", "auto")  # "auto" = follow the face; or 0..1
    c.setdefault("push_in", 0.09)   # slow zoom over the clip; 0 disables
    return c


def note(msg):
    print(f"[plowcut] {msg}", file=sys.stderr, flush=True)


def ready():
    """A recording is ready when its size has not changed for settle_seconds."""
    c, st = config(), load(STATE, {})
    intake, seen = Path(c["intake"]), st.get("seen", {})
    if not intake.is_dir():
        return {"ready": None, "reason": f"intake folder missing: {intake}"}

    exts = {".mov", ".mp4", ".m4v", ".mkv", ".wav", ".m4a", ".mp3"}
    now, sizes = time.time(), st.get("sizes", {})
    candidate = None
    for f in sorted(intake.iterdir()):
        if f.name.startswith(".") or f.suffix.lower() not in exts:
            continue
        key, size = str(f), f.stat().st_size
        prev = sizes.get(key)
        sizes[key] = {"size": size, "at": now if (not prev or prev["size"] != size) else prev["at"]}
        if key in seen:
            continue
        if now - sizes[key]["at"] >= c["settle_seconds"]:
            candidate = f

    st["sizes"] = sizes
    save(STATE, st)
    if not candidate:
        return {"ready": None, "reason": "nothing settled yet"}
    return {"ready": candidate.name, "bytes": candidate.stat().st_size,
            "duration_s": probe_duration(candidate)}


def probe_size(f):
    try:
        out = subprocess.run(
            [probebin(), "-v", "error", "-select_streams", "v:0",
             "-show_entries", "stream=width,height", "-of", "csv=p=0", str(f)],
            capture_output=True, text=True, timeout=60).stdout.strip()
        w, h = out.split(",")[:2]
        return int(w), int(h)
    except Exception:
        return None


def probe_duration(f):
    try:
        out = subprocess.run(
            [probebin(), "-v", "error", "-show_entries", "format=duration",
             "-of", "default=nw=1:nk=1", str(f)],
            capture_output=True, text=True, timeout=60)
        return round(float(out.stdout.strip()))
    except Exception:
        return None


def transcribe():
    r = ready()
    if not r.get("ready"):
        return r
    c = config()
    src = Path(c["intake"]) / r["ready"]
    work = Path(c["work"]) / src.stem
    work.mkdir(parents=True, exist_ok=True)

    note(f"extracting audio from {src.name}")
    wav = work / "audio.wav"
    subprocess.run(["PLACEHOLDER_FF", "-nostdin", "-y", "-i", str(src),
                    "-ac", "1", "-ar", "16000", "-vn", str(wav)],
                   check=True, capture_output=True)

    note("transcribing (this is the long, quiet part)")
    model = Path(c["model"])
    if not model.exists():
        return {"error": f"whisper model missing at {model}",
                "fix": "download ggml-base.en.bin from huggingface.co/ggerganov/whisper.cpp"}
    # Detect the language in its own pass and PIN it. Left on "auto",
    # whisper does not fail when it guesses wrong — it TRANSLATES, and returns
    # fluent text in the wrong language. Everything downstream (topics, hooks,
    # the quoted line the cut snaps to) would then describe words that were
    # never spoken, and nothing about the output would look broken.
    lang = c["language"]
    if lang == "auto":
        det = subprocess.run(["whisper-cli", "-m", str(model), "-l", "auto",
                              "-dl", "-f", str(wav)],
                             capture_output=True, text=True, timeout=600)
        m = re.search(r"auto-detected language:\s*([a-z]{2})",
                      det.stdout + det.stderr)
        if not m:
            return {"error": "could not detect the spoken language",
                    "fix": 'set "language" in ~/.dailies/config.json'}
        lang = m.group(1)
        note(f"language detected: {lang}")

    # One pass, one word per cue (-ml 1 -sow). Sentences are rebuilt from the
    # words below; going the other way is impossible, and the clip has to open
    # on an exact word, not on whatever boundary Whisper felt like drawing.
    subprocess.run(["whisper-cli", "-m", str(model), "-l", lang,
                    "-ml", "1", "-sow",
                    "-f", str(wav), "-oj", "-of", str(work / "transcript")],
                   check=True, capture_output=True)

    st = load(STATE, {})
    st.setdefault("seen", {})[str(src)] = {"at": time.time(), "work": str(work),
                                           "language": lang}
    save(STATE, st)
    note("done")
    return {"transcribed": src.name, "language": lang,
            "transcript": str(work / "transcript.json"),
            "duration_s": r.get("duration_s")}


