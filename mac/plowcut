def srt_time(t):
    h, r = divmod(max(t, 0), 3600); m, sec = divmod(r, 60)
    return f"{int(h):02d}:{int(m):02d}:{int(sec):02d},{int(round((sec % 1) * 1000)):03d}"


def parse_srt(path):
    """[(start_s, end_s, text)] — enough for our own re-emit, not a full parser."""
    out, block = [], []
    for line in Path(path).read_text(encoding="utf8", errors="replace").splitlines() + [""]:
        if line.strip() == "":
            if len(block) >= 2 and "-->" in block[1]:
                a, b = block[1].split("-->")
                out.append((to_s(a), to_s(b), "\n".join(block[2:]).strip()))
            block = []
        else:
            block.append(line)
    return out


def to_s(stamp):
    stamp = stamp.strip().replace(",", ".")
    h, m, s = stamp.split(":")
    return int(h) * 3600 + int(m) * 60 + float(s)


# name -> (width, height, framing filter). Vertical is a centre crop, which is
# right for one person facing the camera and wrong for two people side by side;
# that is a known limit, not an oversight.
def autoframe(src, start, end, samples=5):
    """Where the 9:16 window should sit, from the faces actually in the shot.

    Samples a few frames across the moment and takes the median face centre.
    Median, not mean: one false positive on a poster or a reflection should not
    drag the framing. Returns None when nothing is found, and the caller falls
    back to centre — which is a guess, and says so."""
    finder = HOME / "bin" / "facefind"
    if not finder.exists():
        return None
    tmp = HOME / "work" / ".frames"
    tmp.mkdir(parents=True, exist_ok=True)
    shots = []
    for k in range(samples):
        t = start + (end - start) * (k + 0.5) / samples
        f = tmp / f"f{k}.png"
        try:
            subprocess.run([ffbin(), "-nostdin", "-v", "error", "-y", "-ss", f"{t}",
                            "-i", str(src), "-frames:v", "1", str(f)],
                           check=True, capture_output=True, timeout=120)
            shots.append(str(f))
        except Exception:
            pass
    if not shots:
        return None
    try:
        out = subprocess.run([str(finder), *shots], capture_output=True,
                             text=True, timeout=120).stdout
        results = json.loads(out)
    except Exception:
        return None
    boxes = []
    for r in results:
        if r.get("faces"):
            boxes.append(max(r["faces"], key=lambda b: b["w"] * b["h"]))
    for f in shots:
        Path(f).unlink(missing_ok=True)
    if not boxes:
        return None
    med = lambda k: sorted(b[k] for b in boxes)[len(boxes) // 2]
    return {"x": med("x"), "y": med("y"), "w": med("w"), "h": med("h")}


def framing(fmt, x=0.5):
    """`x` is where the 9:16 window sits horizontally, 0 = left, 1 = right.

    A centre crop is right for one person facing the camera and wrong whenever
    they are not centred — which is most real footage."""
    if fmt == "vertical":
        return (1080, 1920,
                f"crop=ih*9/16:ih:(iw-ih*9/16)*{x:.3f}:0,scale=1080:1920")
    if fmt == "square":
        return (1080, 1080, f"crop=ih:ih:(iw-ih)*{x:.3f}:0,scale=1080:1080")
    return FORMATS[fmt]


FORMATS = {
    "vertical":   (1080, 1920, "crop=ih*9/16:ih,scale=1080:1920"),
    "horizontal": (1920, 1080, "scale=1920:1080:force_original_aspect_ratio=decrease,"
                               "pad=1920:1080:(ow-iw)/2:(oh-ih)/2"),
    "square":     (1080, 1080, "crop=ih:ih,scale=1080:1080"),
}

FPS = 30
ASSETS = HOME / "assets"      # the icon font libass renders by ligature

ICON_FONT = "Material Symbols Rounded"
DISPLAY = "Anton"          # keywords and card titles: condensed, heavy, tight
BODY = "Inter"             # captions and secondary lines

# A thick black outline on everything is what makes an edit look like 2012.
# Weight carries the text; a soft shadow separates it from the picture.
INK = "&H00F2F2F2"         # not pure white — pure white vibrates against video
ACCENT = "&H004AE2FF"      # BGR: a warm amber, well short of pure yellow
ACCENT_HEX = "0xFFE24A"    # the same colour for ffmpeg, which wants RGB
PANEL = "&H00121316"
SHADOW = "&H00000000"


_FF = {}


def ffbin():
    """An ffmpeg that can render text.

    Homebrew's plain `ffmpeg` formula ships without libass or freetype, so
    `drawtext`, `subtitles` and `ass` simply do not exist in it — and the
    failure reads like a filtergraph syntax error, not a missing feature.
    `ffmpeg-full` has them but installs keg-only, off PATH. Look for a capable
    binary instead of trusting whichever one PATH happens to hand us."""
    if "bin" in _FF:
        return _FF["bin"]
    candidates = [config().get("ffmpeg"),
                  "/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg",
                  "/usr/local/opt/ffmpeg-full/bin/ffmpeg", "ffmpeg"]
    plain = None
    for c in candidates:
        if not c:
            continue
        try:
            out = subprocess.run([c, "-hide_banner", "-filters"],
                                 capture_output=True, text=True, timeout=30).stdout
        except Exception:
            continue
        plain = plain or c
        if " subtitles " in out:
            _FF["bin"] = c
            return c
    _FF["bin"] = plain or "ffmpeg"
    return _FF["bin"]


def probebin():
    """The ffprobe that belongs to the chosen ffmpeg.

    Installing ffmpeg-full moved x265, which left the plain formula's ffprobe
    unable to load libx265 — so the one on PATH may be broken even though a
    working one is right next to the ffmpeg we picked."""
    b = ffbin()
    sib = str(Path(b).with_name("ffprobe")) if "/" in b else "ffprobe"
    try:
        if subprocess.run([sib, "-version"], capture_output=True,
                          timeout=15).returncode == 0:
            return sib
    except Exception:
        pass
    return "ffprobe"


def can_caption():
    return " subtitles " in subprocess.run(
        [ffbin(), "-hide_banner", "-filters"],
        capture_output=True, text=True).stdout


ASS_HEAD = """[Script Info]
ScriptType: v4.00+
PlayResX: {w}
PlayResY: {h}
WrapStyle: 2
ScaledBorderAndShadow: yes

[V4+ Styles]
Format: Name,Fontname,Fontsize,PrimaryColour,SecondaryColour,OutlineColour,BackColour,Bold,Italic,Underline,StrikeOut,ScaleX,ScaleY,Spacing,Angle,BorderStyle,Outline,Shadow,Alignment,MarginL,MarginR,MarginV,Encoding
{styles}

[Events]
Format: Layer,Start,End,Style,Name,MarginL,MarginR,MarginV,Effect,Text
"""


def ass_t(t):
    t = max(t, 0); h, r = divmod(t, 3600); m, sec = divmod(r, 60)
    return f"{int(h)}:{int(m):02d}:{int(sec):02d}.{int(round((sec % 1) * 100)):02d}"


def caption_ass(ws, start, end, dest, w, h, per_line=3, hi=ACCENT + "&",
                keywords=None, effects=None, face=None, pip=None):
    """Word-by-word captions: a few words on screen, the spoken one lit.

    We already have a timestamp per word — it is what places the hook — so the
    caption everyone recognises from short-form costs us nothing extra."""
    mute = [(float(e["from"]) - start, float(e["to"]) - start)
            for e in (effects or []) if e.get("type") == "frame"]
    inside = [(t, x) for t, x in ws if start <= t < end
              and not any(lo <= t - start < hi for lo, hi in mute)]
    if not inside and not (keywords or effects):
        return 0
    size = int(h * 0.046)
    lines, n = [], 0
    for g in range(0, len(inside), per_line):
        group = inside[g:g + per_line]
        gend = inside[g + per_line][0] if g + per_line < len(inside) else end
        for i, (t, _) in enumerate(group):
            nxt = group[i + 1][0] if i + 1 < len(group) else gend
            # A line that begins just before a muted window has no next word to
            # end it, so it stretches across the whole window. Clip it at the
            # edge instead.
            for lo, hi in mute:
                if t - start < lo <= nxt - start:
                    nxt = start + lo
            plain = " ".join(x for _, x in group)
            body = " ".join(
                (f"{{\\c{hi}}}{x}{{\\c" + INK + "&}" if j == i else x)
                for j, (_, x) in enumerate(group))
            # Same overflow as the keywords: WrapStyle 2 never wraps, it just
            # runs off both edges. Shrink the line rather than break it — one
            # line is what short-form reads.
            fit = int((w * 0.88) / max(1, len(plain) * 0.47))
            fs = max(int(h * 0.028), min(size, fit))
            lines.append(f"Dialogue: 0,{ass_t(t - start)},{ass_t(nxt - start)},"
                         f"D,,0,0,0,,{{\\fs{fs}}}{body}")
            n += 1
    ksize = int(h * 0.075)
    for k in keywords or []:
        at = float(k["at"])
        if not (start <= at < end):
            continue
        text = str(k.get("text", ""))
        icon = k.get("icon")
        a, b = at - start, min(at - start + float(k.get("hold", 1.9)), end - start)
        # Compose around the speaker, not on top of them. The face box is in
        # source fractions; the vertical crop is none, so its y and height carry
        # straight over. Sit the whole group in the headroom above the face when
        # there is any, and fall back to the old fixed band when there is not.
        top = ((face["y"] - face["h"] / 2) * h) if face else h
        block = int(h * 0.20 if icon else h * 0.09)
        gs_pre = int(h * 0.135) if icon else 0
        floor_y = int(h * 0.045) + gs_pre // 2      # \an5 hangs half the glyph above y
        y = (int(max(floor_y, top - block - h * 0.03))
             if top - block > h * 0.10 else int(h * 0.30 if icon else h * 0.16))
        if icon:
            gs = gs_pre
            lines.append(f"Dialogue: 2,{ass_t(a)},{ass_t(b)},I,,0,0,0,,"
                         f"{{{pop()}\\fs{gs}\\an5\\pos({int(w/2)},{y})}}{icon}")
            y += int(gs * 0.66)
            n += 1
        if text:
            # Long words overflow a fixed size and get sliced by the frame edge.
            # Anton is condensed: about 0.42 em per cap, so the same
            # string carries a much larger body than a grotesque would.
            fit = int((w * 0.90) / max(1, len(text) * 0.42))
            size = max(int(h * 0.034), min(int(h * 0.105), fit))
            lines.append(f"Dialogue: 2,{ass_t(a)},{ass_t(b)},K,,0,0,0,,"
                         f"{{{pop(150)}\\fs{size}\\an8\\pos({int(w/2)},{y})}}{text}")
            n += 1

    lines += fx_events(effects, start, end, w, h, face, pip)
    n += len(effects or [])
    head = ASS_HEAD.format(w=w, h=h, styles=fx_styles(w, h))
    Path(dest).write_text(head + "\n".join(lines) + "\n", encoding="utf8")
    return n


