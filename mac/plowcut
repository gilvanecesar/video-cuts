def ass_t(t):
    t = max(t, 0); h, r = divmod(t, 3600); m, sec = divmod(r, 60)
    return f"{int(h)}:{int(m):02d}:{int(sec):02d}.{int(round((sec % 1) * 100)):02d}"


def caption_ass(ws, start, end, dest, w, h, per_line=3, hi=ACCENT_INLINE,
                keywords=None, effects=None, face=None, pip=None):
    """Word-by-word captions: a few words on screen, the spoken one lit.

    We already have a timestamp per word — it is what places the hook — so the
    caption everyone recognises from short-form costs us nothing extra."""
    mute = [(float(e["from"]) - start, float(e["to"]) - start)
            for e in (effects or []) if e.get("type") == "frame"]
    inside = [(t, x) for t, x in ws if start <= t < end
              and not any(m0 <= t - start < m1 for m0, m1 in mute)]
    if not inside and not (keywords or effects):
        return 0
    size = int(h * 0.046)
    lines, n = [], 0
    for g in range(0, len(inside), per_line):
        group = inside[g:g + per_line]
        gend = inside[g + per_line][0] if g + per_line < len(inside) else end
        for i, (t, _) in enumerate(group):
            nxt = group[i + 1][0] if i + 1 < len(group) else gend
            # A line that begins just before a muted window has no next word to
            # end it, so it stretches across the whole window. Clip it at the
            # edge instead.
            for m_lo, _m_hi in mute:
                if t - start < m_lo <= nxt - start:
                    nxt = start + m_lo
            plain = " ".join(x for _, x in group)
            body = " ".join(
                (f"{{\\c{hi}}}{x}{{\\c&HF2F2F2&}}" if j == i else x)
                for j, (_, x) in enumerate(group))
            # Same overflow as the keywords: WrapStyle 2 never wraps, it just
            # runs off both edges. Shrink the line rather than break it — one
            # line is what short-form reads.
            fit = int((w * 0.88) / max(1, len(plain) * 0.47))
            fs = max(int(h * 0.028), min(size, fit))
            lines.append(f"Dialogue: 0,{ass_t(t - start)},{ass_t(nxt - start)},"
                         f"D,,0,0,0,,{{\\fs{fs}}}{body}")
            n += 1
    ksize = int(h * 0.075)
    for k in keywords or []:
        at = float(k["at"])
        if not (start <= at < end):
            continue
        text = str(k.get("text", ""))
        icon = k.get("icon")
        a, b = at - start, min(at - start + float(k.get("hold", 1.9)), end - start)
        # Compose around the speaker, not on top of them. The face box is in
        # source fractions; the vertical crop is none, so its y and height carry
        # straight over. Sit the whole group in the headroom above the face when
        # there is any, and fall back to the old fixed band when there is not.
        top = ((face["y"] - face["h"] / 2) * h) if face else h
        block = int(h * 0.20 if icon else h * 0.09)
        gs_pre = int(h * 0.135) if icon else 0
        floor_y = int(h * 0.045) + gs_pre // 2      # \an5 hangs half the glyph above y
        y = (int(max(floor_y, top - block - h * 0.03))
             if top - block > h * 0.10 else int(h * 0.30 if icon else h * 0.16))
        if icon:
            gs = gs_pre
            lines.append(f"Dialogue: 2,{ass_t(a)},{ass_t(b)},I,,0,0,0,,"
                         f"{{{pop()}\\fs{gs}\\an5\\pos({int(w/2)},{y})}}{icon}")
            y += int(gs * 0.66)
            n += 1
        if text:
            # Long words overflow a fixed size and get sliced by the frame edge.
            # Anton is condensed: about 0.42 em per cap, so the same
            # string carries a much larger body than a grotesque would.
            fit = int((w * 0.90) / max(1, len(text) * 0.42))
            size = max(int(h * 0.034), min(int(h * 0.105), fit))
            lines.append(f"Dialogue: 2,{ass_t(a)},{ass_t(b)},K,,0,0,0,,"
                         f"{{{pop(150)}\\fs{size}\\an8\\pos({int(w/2)},{y})}}{text}")
            n += 1

    lines += fx_events(effects, start, end, w, h, face, pip)
    n += len(effects or [])
    head = ASS_HEAD.format(w=w, h=h, styles=fx_styles(w, h))
    Path(dest).write_text(head + "\n".join(lines) + "\n", encoding="utf8")
    return n


