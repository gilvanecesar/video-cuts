#!/usr/bin/env python3
"""plowcut — the Mac-side half of Video Cuts.

Every subcommand takes NO arguments. That is the whole point: Latch keys a
standing approval on the exact argv, so `plowcut transcribe` must be
byte-identical on every run or the owner gets asked again for each new file.
The variable part — which recording, which clip — lives in state here, never
in the arguments the agent sends.

    plowcut fetch       download the URL named in ~/.dailies/fetch.json
    plowcut ready       is there a finished recording waiting?
    plowcut transcript  the newest transcript, compacted for reading
    plowcut index       every topic this owner has covered, across recordings
    plowcut search      where they said something, from ~/.dailies/query.json
    plowcut remember    fold ~/.dailies/learn.json into that index
    plowcut cut         cut the clips named in ~/.dailies/plan.json
    plowcut archive     put the finished recording away, marked and dated
    plowcut pending     clips on disk that have not been published
    plowcut publish     record what went online, from ~/.dailies/publish.json
    plowcut performance what has been published, and any views we were told
    plowcut yt-connect  start the YouTube device flow (returns a code to text)
    plowcut yt-poll     finish it after the owner approves
    plowcut yt-upload   upload ~/.dailies/publish-plan.json to YouTube
    plowcut yt-status   is YouTube connected?
    plowcut yt-stats    subscribers, views, and recent clips with their numbers
    plowcut transcribe  transcribe the one that is waiting
    plowcut status      what plowcut knows

Output is JSON on stdout. Progress goes to stderr so a long job is never
silent (Latch kills a silent, write-less, network-less command at 15 minutes).
"""
import json, math, os, re, shutil, subprocess, sys, time
from pathlib import Path

HOME = Path(os.environ.get("DAILIES_HOME", Path.home() / ".dailies"))
CONFIG, STATE = HOME / "config.json", HOME / "state.json"
# Intake sits beside the state dir, not under a bare ~/Movies — in the cloud
# HOME is /root while the agent's data lives under DAILIES_HOME, and a bare
# home path sends `fetch` and `ready` to different places. DAILIES_INTAKE can
# still override it (the Mac install points it at ~/Movies/Dailies).
DEFAULT_INTAKE = Path(os.environ.get(
    "DAILIES_INTAKE",
    Path.home() / "Movies" / "Dailies" if (Path.home() / "Movies").is_dir()
    else HOME / "intake"))


def load(p, default):
    try:
        return json.loads(p.read_text())
    except Exception:
        return default


def save(p, obj):
    HOME.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(obj, indent=2))


def config():
    c = load(CONFIG, {})
    c.setdefault("intake", str(DEFAULT_INTAKE))
    c.setdefault("work", str(HOME / "work"))
    # Where finished clips land, and where a recording goes once it is done
    # with. Both live beside the intake folder, in the open: work/ holds the
    # audio and transcript, which nobody wants to look at.
    c.setdefault("delivery", str(DEFAULT_INTAKE / "Cortes"))
    c.setdefault("archive", str(DEFAULT_INTAKE / "Prontos"))
    c.setdefault("done_marker", "cortado")
    # Where the Python side lives when whisper-cli is absent. The container has
    # no Homebrew and no whisper.cpp, so the same pipeline runs on
    # faster-whisper instead — same transcript shape, same everything after it.
    c.setdefault("venv", "/opt/dailies/venv" if Path("/opt/dailies/venv").exists()
                 else str(HOME / "venv"))
    c.setdefault("settle_seconds", 90)   # size must hold still this long
    # small.en, not base.en: base garbles roughly a third of a recording, and
    # every topic and moment the agent picks rests on this text. 465MB and
    # ~23x realtime on an M4 is a cheap price for a transcript worth reading.
    c.setdefault("model", str(HOME / "models" / "ggml-small.bin"))
    # "auto" lets whisper detect it. The multilingual model is the default on
    # purpose: an .en model does not merely do worse on other languages, it
    # invents or force-translates, and every topic the agent picks rests on
    # this text.
    c.setdefault("language", "auto")
    c.setdefault("model_size", "small")
    c.setdefault("formats", ["vertical", "horizontal"])
    c.setdefault("crop_x", "auto")  # "auto" = follow the face; or 0..1
    c.setdefault("push_in", 0.09)   # slow zoom over the clip; 0 disables
    return c


def note(msg):
    print(f"[plowcut] {msg}", file=sys.stderr, flush=True)


def ready():
    """A recording is ready when its size has not changed for settle_seconds."""
    c, st = config(), load(STATE, {})
    intake, seen = Path(c["intake"]), st.get("seen", {})
    if not intake.is_dir():
        return {"ready": None, "reason": f"intake folder missing: {intake}"}

    exts = {".mov", ".mp4", ".m4v", ".mkv", ".wav", ".m4a", ".mp3"}
    now, sizes = time.time(), st.get("sizes", {})
    candidate = None
    for f in sorted(intake.iterdir()):
        if f.name.startswith(".") or f.suffix.lower() not in exts:
            continue
        key, size = str(f), f.stat().st_size
        prev = sizes.get(key)
        # at == 0 is the mark `fetch` leaves: a downloaded file is ready the
        # instant it lands, so keep that mark instead of restarting the clock.
        if prev and prev.get("at") == 0 and prev["size"] == size:
            sizes[key] = prev
        else:
            sizes[key] = {"size": size,
                          "at": now if (not prev or prev["size"] != size) else prev["at"]}
        if key in seen:
            continue
        if sizes[key]["at"] == 0 or now - sizes[key]["at"] >= c["settle_seconds"]:
            candidate = f

    st["sizes"] = sizes
    save(STATE, st)
    if not candidate:
        return {"ready": None, "reason": "nothing settled yet"}
    return {"ready": candidate.name, "bytes": candidate.stat().st_size,
            "duration_s": probe_duration(candidate)}


def venv_python():
    p = Path(config()["venv"]) / "bin" / "python"
    return str(p) if p.exists() else None


def fetch():
    """Pull a recording down from a URL named in ~/.dailies/fetch.json.

    A link is the right door for anyone who publishes long video: the episode
    is already online, so asking them to find the master file and upload it is
    asking for the one thing they were trying to avoid."""
    f = HOME / "fetch.json"
    if not f.exists():
        return {"error": "no fetch.json", "expected": str(f)}
    url = json.loads(f.read_text()).get("url")
    if not url:
        return {"error": "fetch.json needs a url"}
    py = venv_python()
    ytdlp = str(Path(py).with_name("yt-dlp")) if py else (shutil.which("yt-dlp") or "")
    if not ytdlp or not Path(ytdlp).exists():
        return {"error": "yt-dlp is not installed", "fix": "install yt-dlp"}

    intake = Path(config()["intake"])
    intake.mkdir(parents=True, exist_ok=True)
    note("fetching " + url)
    ff = ffbin()
    cmd = [ytdlp, "-f", "bv*[height<=1080]+ba/b[height<=1080]/b",
           "--merge-output-format", "mp4", "--no-playlist", "--newline",
           "-o", str(intake / "%(title).80s.%(ext)s"),
           "--print", "after_move:filepath", url]
    # yt-dlp pulls video and audio as separate DASH streams and needs ffmpeg to
    # mux them into one mp4. ffmpeg-full is keg-only (off PATH), so yt-dlp can't
    # find it on its own — hand it the location, or it leaves the split .fNNN
    # files behind and the merged .mp4 the rest of the pipeline expects never
    # appears (the FileNotFoundError we hit).
    if "/" in ff:
        cmd[1:1] = ["--ffmpeg-location", str(Path(ff).parent)]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=3600)
    if r.returncode != 0:
        return {"error": "download failed", "stderr": (r.stderr or "")[-600:]}
    got = [l for l in r.stdout.strip().splitlines() if l.startswith("/")]
    if not got:
        return {"error": "downloaded but could not tell where",
                "stdout": r.stdout[-400:]}
    g = Path(got[-1])
    note("done")
    # A downloaded file is ready the instant it lands — it does not need to
    # "settle" like a file being written into a watched folder. at=0 is the mark
    # `ready` respects so it picks the file up now instead of waiting.
    st = load(STATE, {})
    st.setdefault("sizes", {})[str(g)] = {"size": g.stat().st_size, "at": 0}
    save(STATE, st)
    return {"fetched": g.name, "bytes": g.stat().st_size,
            "duration_s": probe_duration(g)}


PY_TRANSCRIBE = "\n".join([
    "import json",
    "from faster_whisper import WhisperModel",
    "m = WhisperModel(SIZE, device='cpu', compute_type='int8')",
    "segs, info = m.transcribe(WAV, language=LANG, word_timestamps=True)",
    "out = []",
    "for s in segs:",
    "    for w in (s.words or []):",
    "        out.append({'offsets': {'from': int(w.start * 1000),",
    "                                'to': int(w.end * 1000)}, 'text': w.word})",
    "json.dump({'transcription': out, 'language': info.language}, open(DEST, 'w'))",
    "print(info.language)",
])


def whisper_py(wav, work, lang):
    """Transcribe with faster-whisper, writing the shape whisper.cpp writes.

    Everything downstream — words, lines, hooks, captions — reads that one
    format, so the backend is the only thing that differs between a Mac with
    whisper.cpp and a container without it."""
    py = venv_python()
    if not py:
        return None
    c = config()
    head = "\n".join([
        "SIZE = " + repr(c["model_size"]),
        "WAV = " + repr(str(wav)),
        "LANG = " + repr(None if lang == "auto" else lang),
        "DEST = " + repr(str(work / "transcript.json")),
    ])
    r = subprocess.run([py, "-c", head + "\n" + PY_TRANSCRIBE],
                       capture_output=True, text=True, timeout=7200)
    if r.returncode != 0:
        raise subprocess.CalledProcessError(r.returncode, "faster-whisper",
                                            output=r.stdout, stderr=r.stderr)
    lines = (r.stdout or "").strip().splitlines()
    return lines[-1] if lines else lang


def whisper(args, timeout=3600):
    """whisper-cli, on the GPU when it is allowed and on the CPU when it is not.

    Latch's seatbelt sandbox denies GPU access, so Metal buffer allocation fails
    inside it and succeeds outside — the same denial is why Vision finds no
    faces there. Metal is about 4.5x faster, so try it and fall back rather than
    paying the CPU price on every run."""
    r = subprocess.run(["whisper-cli", *args], capture_output=True, text=True,
                       timeout=timeout)
    blob = (r.stdout or "") + (r.stderr or "")
    if r.returncode != 0 and ("metal" in blob.lower() or "ggml_gallocr" in blob
                              or "buffer" in blob.lower()):
        note("GPU unavailable here — retrying on CPU")
        r = subprocess.run(["whisper-cli", "-ng", *args], capture_output=True,
                           text=True, timeout=timeout)
    return r


def probe_size(f):
    try:
        out = subprocess.run(
            [probebin(), "-v", "error", "-select_streams", "v:0",
             "-show_entries", "stream=width,height", "-of", "csv=p=0", str(f)],
            capture_output=True, text=True, timeout=60).stdout.strip()
        w, h = out.split(",")[:2]
        return int(w), int(h)
    except Exception:
        return None


def probe_duration(f):
    try:
        out = subprocess.run(
            [probebin(), "-v", "error", "-show_entries", "format=duration",
             "-of", "default=nw=1:nk=1", str(f)],
            capture_output=True, text=True, timeout=60)
        return round(float(out.stdout.strip()))
    except Exception:
        return None


def transcribe():
    r = ready()
    if not r.get("ready"):
        return r
    # `ready` carries the duration; grab it now, because the whisper-cli branch
    # below rebinds `r` to a CompletedProcess and `r.get(...)` would then raise.
    duration_s = r.get("duration_s")
    c = config()
    src = Path(c["intake"]) / r["ready"]
    work = Path(c["work"]) / src.stem
    work.mkdir(parents=True, exist_ok=True)

    note(f"extracting audio from {src.name}")
    wav = work / "audio.wav"
    subprocess.run([ffbin(), "-nostdin", "-y", "-i", str(src),
                    "-ac", "1", "-ar", "16000", "-vn", str(wav)],
                   check=True, capture_output=True)

    note("transcribing (this is the long, quiet part)")
    # Two backends, one transcript shape. whisper.cpp when the Mac has it,
    # faster-whisper when it does not — which is every container.
    if shutil.which("whisper-cli"):
        model = Path(c["model"])
        if not model.exists():
            return {"error": f"whisper model missing at {model}",
                    "fix": "run mac/install.sh"}
        lang = c["language"]
        if lang == "auto":
            det = whisper(["-m", str(model), "-l", "auto", "-dl", "-f", str(wav)])
            m = re.search(r"auto-detected language:\s*([a-z]{2})",
                          det.stdout + det.stderr)
            if not m:
                return {"error": "could not detect the spoken language",
                        "fix": 'set "language" in ~/.dailies/config.json'}
            lang = m.group(1)
            note(f"language detected: {lang}")
        r = whisper(["-m", str(model), "-l", lang, "-ml", "1", "-sow",
                     "-f", str(wav), "-oj", "-of", str(work / "transcript")])
        if r.returncode != 0:
            raise subprocess.CalledProcessError(r.returncode, "whisper-cli",
                                                output=r.stdout, stderr=r.stderr)
    elif venv_python():
        note("no whisper.cpp here — transcribing with faster-whisper")
        lang = whisper_py(wav, work, c["language"]) or c["language"]
        note(f"language: {lang}")
    else:
        return {"error": "no transcription backend",
                "fix": "run mac/install.sh, or build the container image"}

    st = load(STATE, {})
    st.setdefault("seen", {})[str(src)] = {"at": time.time(), "work": str(work),
                                           "language": lang}
    save(STATE, st)
    note("done")
    # The lines come back here so the normal flow needs no second call — and
    # no second Latch prompt. `transcript` still exists for re-reading later.
    return {"transcribed": src.name, "language": lang,
            "transcript": str(work / "transcript.json"),
            "duration_s": duration_s,
            "lines": to_lines(words(work))}


