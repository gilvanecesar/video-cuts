como quando onde porque pois mas entao ai la ca ta tao ser estar ter fazer
foi era sao esta estao tem tinha vai vou pra pro né então""".split())


def pick_keywords(ws, start, end, want=2, min_len=6):
    """Words worth putting on screen, and exactly when they are said.

    This is the effect that reads as a real edit rather than a caption: the word
    lands on the frame at the instant it leaves the mouth. We can do it because
    the transcript is already word-by-word — the same data that places the hook.
    The agent may name these in the plan; this is the fallback."""
    inside = [(t, x) for t, x in ws if start + 0.6 <= t < end - 1.2]
    scored = []
    for t, raw in inside:
        w = "".join(c for c in raw if c.isalnum() or c in "-áéíóúâêôãõçÁÉÍÓÚÂÊÔÃÕÇ")
        if len(w) < min_len or norm(w) in STOP:
            continue
        scored.append((len(w), t, w))
    scored.sort(reverse=True)
    picked, used = [], []
    for _, t, w in scored:
        if any(abs(t - u) < 4.0 for u in used):
            continue
        picked.append({"text": w.upper(), "at": t}); used.append(t)
        if len(picked) >= want:
            break
    return sorted(picked, key=lambda k: k["at"])


# --------------------------------------------------------------------------
# the graphic layer
#
# Icons, cards, lower thirds and captions are all text to libass, so the whole
# overlay is one ASS file and one render pass. Icons come from a Material
# Symbols font by ligature — the agent asks for "smartphone" and gets the
# glyph — which is why there is no icon directory to manage and nothing to
# rasterise. Only zoom lives in ffmpeg, because it moves the picture itself.
# --------------------------------------------------------------------------

def fx_styles(w, h):
    cap = int(h * 0.048)
    return f"""Style: D,{BODY},{cap},{INK},{INK},{SHADOW},{SHADOW},-1,0,0,0,100,100,-1,0,1,0,{max(3, cap // 16)},2,{int(w*0.09)},{int(w*0.09)},{int(h*0.125)},1
Style: DH,{BODY},{cap},{ACCENT},{ACCENT},{SHADOW},{SHADOW},-1,0,0,0,100,100,-1,0,1,0,{max(3, cap // 16)},2,{int(w*0.09)},{int(w*0.09)},{int(h*0.125)},1
Style: K,{DISPLAY},{int(h*0.088)},{INK},{INK},{SHADOW},{SHADOW},0,0,0,0,100,100,-2,0,1,0,{int(h*0.0032)},5,20,20,20,1
Style: I,{ICON_FONT},{int(h*0.11)},{ACCENT},{ACCENT},{SHADOW},{SHADOW},0,0,0,0,100,100,0,0,1,0,{int(h*0.0022)},5,20,20,20,1
Style: CT,{DISPLAY},{int(h*0.062)},{INK},{INK},{SHADOW},{SHADOW},0,0,0,0,100,100,-1,0,1,0,0,7,20,20,20,1
Style: CS,{BODY},{int(h*0.030)},&H00A8A8A8,&H00A8A8A8,{SHADOW},{SHADOW},0,0,0,0,100,100,0,0,1,0,0,7,20,20,20,1
Style: BOX,{BODY},20,{PANEL},{PANEL},{PANEL},{PANEL},0,0,0,0,100,100,0,0,1,0,0,7,0,0,0,1
Style: RULE,{BODY},20,{ACCENT},{ACCENT},{ACCENT},{ACCENT},0,0,0,0,100,100,0,0,1,0,0,7,0,0,0,1"""


def box(x, y, bw, bh, r=0):
    """An ASS drawing rectangle, optionally with rounded corners.

    Sharp corners are the other half of why a panel reads as PowerPoint. ASS
    drawing mode has cubic beziers, so a real radius costs four curves."""
    if r <= 0:
        return f"{{\\p1\\pos({x},{y})}}m 0 0 l {bw} 0 l {bw} {bh} l 0 {bh}{{\\p0}}"
    k = int(r * 0.45)          # bezier handle for a quarter circle
    return (f"{{\\p1\\pos({x},{y})}}"
            f"m {r} 0 l {bw-r} 0 b {bw-k} 0 {bw} {k} {bw} {r} "
            f"l {bw} {bh-r} b {bw} {bh-k} {bw-k} {bh} {bw-r} {bh} "
            f"l {r} {bh} b {k} {bh} 0 {bh-k} 0 {bh-r} "
            f"l 0 {r} b 0 {k} {k} 0 {r} 0{{\\p0}}")


def pop(ms=150, over=112):
    """Overshoot and settle back, instead of a straight line to full size.

    Three segments approximate an ease-out with a little bounce: past the mark,
    slightly under, then home. Linear scaling is what makes motion feel like a
    slide transition."""
    a, b, c = int(ms * 0.55), int(ms * 0.85), ms
    return (f"\\fad(80,140)\\fscx40\\fscy40"
            f"\\t(0,{a},0.6,\\fscx{over}\\fscy{over})"
            f"\\t({a},{b},\\fscx97\\fscy97)"
            f"\\t({b},{c},\\fscx100\\fscy100)")


def rounded_mask(w, h, r, dest):
    """A rounded-rectangle alpha mask, rendered once and reused per frame.

    geq is per-pixel and slow; running it on one still and merging is the
    difference between a clip that renders in seconds and one that does not."""
    if Path(dest).exists():
        return dest
    expr = (f"if(lte(pow(max(max(0\\,{r}-X)\\,X-(W-{r}))\\,2)"
            f"+pow(max(max(0\\,{r}-Y)\\,Y-(H-{r}))\\,2),{r}*{r}),255,0)")
    subprocess.run([ffbin(), "-nostdin", "-v", "error", "-y",
                    "-f", "lavfi", "-i", f"color=c=black:s={w}x{h}:d=1",
                    "-vf", f"format=gray,geq=lum='{expr}'",
                    "-frames:v", "1", str(dest)], check=True, capture_output=True)
    return dest


def pip_graph(frames, w, h, tmp):
    """Compose the speaker into a rounded, tilted card over a blurred plate.

    In a tight talking head there is no honest place to put a panel: it either
    covers the face or crowds the caption. Shrinking the picture makes room,
    which is what an editor does and what a fixed overlay cannot."""
    if not frames:
        return None, [], None
    e = frames[0]
    a, b = float(e["_a"]), float(e["_b"])
    sc = float(e.get("scale", 0.52))
    ang = float(e.get("angle", -3.5))
    pw, ph = int(w * sc) // 2 * 2, int(h * sc) // 2 * 2
    bd = max(4, int(w * 0.008))
    r = int(min(pw, ph) * 0.075)
    align = e.get("align", "top")

    pm = rounded_mask(pw, ph, r, tmp / f"m{pw}x{ph}r{r}.png")
    bm = rounded_mask(pw + 2 * bd, ph + 2 * bd, r + bd,
                      tmp / f"m{pw+2*bd}x{ph+2*bd}r{r+bd}.png")

    x = int((w - pw) / 2)
    y = int(h * 0.035) if align == "top" else int(h - ph - h * 0.26)
    rad = f"{ang}*PI/180"
    inputs = ["-loop", "1", "-i", str(pm), "-loop", "1", "-i", str(bm)]
    win = f"between(t,{a:.2f},{b:.2f})"
    # Blur by shrinking and growing back rather than convolving at full size:
    # a 22px box blur over 1080x1920 costs more than the rest of the clip put
    # together. And gate every expensive filter on the window — without it they
    # run on every frame and only the compositing step is skipped.
    g = (
        f"[v]split=3[b0][b1][b2];"
        f"[b1]scale=iw/10:-2,gblur=sigma=5,scale={w}:{h}:flags=bilinear,"
        f"eq=brightness=-0.12:saturation=0.80[blur];"
        f"[b0][blur]overlay=0:0:enable='{win}'[bgz];"
        f"[b2]scale={pw}:{ph},format=rgba[praw];"
        f"[1:v]format=gray[pm];[praw][pm]alphamerge[pa];"
        f"color=c={ACCENT_HEX}:s={pw+2*bd}x{ph+2*bd}:d={b-a+1:.2f}:r={FPS},format=rgba[bc];"
        f"[2:v]format=gray[bm];[bc][bm]alphamerge[bd0];"
        f"[bd0][pa]overlay={bd}:{bd}:shortest=1[card];"
        f"[card]rotate={rad}:c=none:ow=rotw({rad}):oh=roth({rad}):enable='{win}'[cardr];"
        f"[bgz][cardr]overlay=(W-w)/2:{y-bd}:enable='{win}'[vout]"
    )
    # Rotation grows the box: the occupied height is the rotated bounding box,
    # not the card's own height, and a panel placed by the smaller number lands
    # back on top of the picture.
    th = abs(math.radians(ang))
    roth = (ph + 2 * bd) * math.cos(th) + (pw + 2 * bd) * math.sin(th)
    return g, inputs, {"a": a, "b": b, "bottom": int(y - bd + roth)}


def fx_events(effects, start, end, w, h, face=None, pip=None):
    """Compile the agent's effect list into ASS dialogue lines."""
    out = []
    for e in effects or []:
        kind = e.get("type")
        a = float(e.get("at", e.get("from", 0))) - start
        b = float(e.get("to", e.get("at", 0) + 2.0)) - start
        if b <= 0 or a >= end - start:
            continue
        a, b = max(0.0, a), min(b, end - start)

        if kind == "card":
            title, sub = str(e.get("title", "")), str(e.get("sub", ""))
            icon = e.get("icon")
            pad = int(w * 0.055)
            tfs = max(int(h * 0.030),
                      min(int(h * 0.058), int((w * 0.62) / max(1, len(title) * 0.50))))
            sfs = int(tfs * 0.48)
            gs = int(tfs * 1.45) if icon else 0
            longest = max(len(title), len(sub) * 0.62 if sub else 0)
            bw = int(min(w * 0.86, max(w * 0.50, pad * 2 + tfs * 0.50 * longest)))
            bh = int(pad * 1.5 + gs * (1.25 if icon else 0) + tfs * 1.15
                     + (sfs * 1.9 if sub else 0))
            r = int(h * 0.014)
            x = int((w - bw) / 2)
            # A frame effect shrinks the speaker to make room; putting the panel
            # back over them wastes the room it just made.
            if pip and not (b <= pip["a"] or a >= pip["b"]):
                y = int(pip["bottom"] + h * 0.030)
            elif face:
                top_f = (face["y"] - face["h"] / 2) * h
                bot_f = (face["y"] + face["h"] / 2) * h
                if top_f - bh > h * 0.07:
                    y = int(max(h * 0.05, top_f - bh - h * 0.035))   # headroom
                else:
                    y = int(min(h * 0.68 - bh, bot_f + h * 0.035))   # below the face
            else:
                y = int(h * 0.23)
            # Panel, then a hairline accent rule down its left edge — the rule
            # is what stops a dark rectangle from reading as a placeholder.
            out.append(f"Dialogue: 1,{ass_t(a)},{ass_t(b)},BOX,,0,0,0,,"
                       f"{{\\fad(140,200)\\alpha&H1A&"
                       f"\\clip({x},{y},{x},{y+bh})\\t(0,240,\\clip({x},{y},{x+bw},{y+bh}))}}"
                       f"{box(x, y, bw, bh, r)}")
            out.append(f"Dialogue: 1,{ass_t(a)},{ass_t(b)},RULE,,0,0,0,,"
                       f"{{\\fad(240,200)}}{box(x, y + r, int(h*0.004), bh - 2*r)}")
            tx, ty = x + pad, y + int(pad * 0.75)
            if icon:
                out.append(f"Dialogue: 2,{ass_t(a)},{ass_t(b)},I,,0,0,0,,"
                           f"{{{pop()}\\fs{gs}\\an7\\pos({tx},{ty})}}{icon}")
                ty += int(gs * 1.25)
            out.append(f"Dialogue: 2,{ass_t(a)},{ass_t(b)},CT,,0,0,0,,"
                       f"{{{pop(170)}\\fs{tfs}\\an7\\pos({tx},{ty})}}{title}")
            if sub:
                out.append(f"Dialogue: 2,{ass_t(a)},{ass_t(b)},CS,,0,0,0,,"
                           f"{{\\fad(260,180)\\fs{sfs}\\an7"
                           f"\\pos({tx},{ty + int(tfs * 1.25)})}}{sub}")

        elif kind == "lower_third":
            text = str(e.get("text", ""))
            fs = int(h * 0.026)
            bh, r = int(fs * 2.3), int(fs * 0.5)
            bw = min(int(w * 0.82), int(fs * 0.52 * len(text) + w * 0.075))
            x, y = int(w * 0.07), int(h * 0.735)
            out.append(f"Dialogue: 1,{ass_t(a)},{ass_t(b)},BOX,,0,0,0,,"
                       f"{{\\fad(150,200)\\alpha&H22&\\clip({x},{y},{x},{y+bh})"
                       f"\\t(0,300,0.5,\\clip({x},{y},{x+bw},{y+bh}))}}{box(x, y, bw, bh, r)}")
            out.append(f"Dialogue: 1,{ass_t(a)},{ass_t(b)},RULE,,0,0,0,,"
                       f"{{\\fad(300,200)}}{box(x, y + r, int(h*0.0035), bh - 2*r)}")
            out.append(f"Dialogue: 2,{ass_t(a)},{ass_t(b)},CS,,0,0,0,,"
                       f"{{\\fad(320,180)\\an4\\fs{fs}\\c" + INK + "&"
                       f"\\pos({x+int(w*0.028)},{y+int(bh*0.52)})}}{text}")

        elif kind == "flash":
            out.append(f"Dialogue: 3,{ass_t(a)},{ass_t(min(a + 0.18, b))},BOX,,0,0,0,,"
                       f"{{\\fad(0,140)\\alpha&H80&\\c&H00FFFFFF&}}{box(0, 0, w, h)}")
    return out


def zoom_expr(effects, dur, push_in, fps):
    """One zoompan expression: a slow drift plus a decaying bump per punch.

    A punch is a bump on the same curve rather than a cut, so the picture never
    jumps — it lunges and settles, which is what the eye reads as emphasis."""
    terms = [f"1+{push_in}*on/({fps}*{max(0.1, dur):.2f})"] if push_in else ["1"]
    for e in effects or []:
        if e.get("type") not in ("punch", "pull"):
            continue
        at = float(e.get("at", 0))
        amt = float(e.get("amount", 0.10)) * (1 if e["type"] == "punch" else -1)
        terms.append(f"{amt:+.3f}*exp(-pow((on/{fps}-{at:.2f})*2.2,2))")
    return "".join(terms)


def norm(t):
    import unicodedata
    t = unicodedata.normalize("NFD", t.lower())
    return " ".join("".join(c for c in t if c.isalnum() or c.isspace()).split())


def snap(ws, hook_text, hint, window=90):
    """Start time of `hook_text` in the word stream, searched around `hint`.

    The agent quotes the line the clip should open on; this finds the word it
    starts at. Without it the clip opens wherever Whisper drew a boundary, and
    a clip that opens on ten seconds of preamble has already lost the viewer."""
    want = norm(hook_text).split()
    if not want:
        return None
    near = [(i, t) for i, (t, _) in enumerate(ws) if abs(t - hint) <= window]
    for i, t in near:
        got = norm(" ".join(w for _, w in ws[i:i + len(want) + 4])).split()
        if got[:len(want)] == want:
            return t
    return None


def cut():
    """Cut the clips named in ~/.dailies/plan.json.

    The plan is a FILE, not arguments: the agent writes it with plow_write_file
    at this fixed path, then calls `plowcut cut`. That keeps the argv identical
    on every run, which is what makes one Latch approval last.

    plan.json:
      {"source": "<stem of the transcribed recording>",
       "clips": [{"title": "...", "start": 123.4, "end": 168.0}]}
    """
    c = config()
    plan_path = HOME / "plan.json"
    if not plan_path.exists():
        return {"error": "no plan", "expected": str(plan_path)}
    plan = json.loads(plan_path.read_text())

    # Filenames with accents reach us in different unicode normal forms
    # depending on who typed them; compare in NFC or "VOCÊ" never matches "VOCÊ".
    import unicodedata
    want = unicodedata.normalize("NFC", plan["source"])
    work = Path(c["work"]) / plan["source"]
    # Look in the archive too: a recording that has been put away can still
    # give up another clip weeks later, and the owner should not have to drag
    # the file back to ask for one.
    src = None
    for folder in (Path(c["intake"]), Path(c["archive"])):
        if not folder.is_dir():
            continue
        for f in folder.iterdir():
            stem = unicodedata.normalize("NFC", f.stem)
            if not f.name.startswith(".") and (
                    stem == want or stem.startswith(want + " [")):
                src = f
                break
        if src:
            break
    # Renamed or moved after transcription? The state remembers the exact path
    # that was processed under this stem — fall back to it, and to the archive
    # copy, before giving up. The cut only needs the original's frames; its
    # current name does not matter.
    if not src:
        for path, meta in load(STATE, {}).get("seen", {}).items():
            if Path(meta.get("work", "")).name == plan["source"] and Path(path).exists():
                src = Path(path)
                break
    if not src:
        # Last resort: the work dir has the audio we transcribed; a cut can be
        # made straight from the recording if we can still see it anywhere by
        # matching the stem loosely (accents/renames).
        wn = norm(plan["source"])
        for folder in (Path(c["intake"]), Path(c["archive"])):
            if not folder.is_dir():
                continue
            cand = [f for f in folder.iterdir()
                    if not f.name.startswith(".") and f.suffix.lower() in
                    {".mp4", ".mov", ".m4v", ".mkv"}]
            if len(cand) == 1:
                src = cand[0]; break
    if not src:
        return {"error": f"source recording not found for stem {plan['source']!r}",
                "hint": "the original may have been renamed or removed; drop it "
                        "back in the intake folder to cut from it again"}

    outdir = Path(c["delivery"]) / src.stem
    outdir.mkdir(parents=True, exist_ok=True)
    ws = words(work)

    captions = can_caption()
    if not captions:
        note("this ffmpeg cannot render text — cutting without captions "
             "(brew install ffmpeg-full)")
    made = []
    for i, clip in enumerate(plan.get("clips", []), 1):
        start, end = float(clip["start"]), float(clip["end"])
        hook = clip.get("hook_text")
        if hook:
            at = snap(ws, hook, start)
            if at is None:
                note(f"  hook not found in the audio: {hook!r} — keeping {start}s")
            else:
                if abs(at - start) > 0.05:
                    note(f"  hook snapped {start:.1f}s → {at:.1f}s")
                start = at
        slug = "".join(ch if ch.isalnum() else "-" for ch in clip.get("title", f"clip{i}")).strip("-").lower()[:60]
        note(f"cutting {i}/{len(plan['clips'])}: {clip.get('title','')} [{start:.0f}s-{end:.0f}s]")

        crop_x = c["crop_x"]
        if crop_x == "auto":
            face = autoframe(src, start, end)
            fx_face = face["x"] if face else None
            if fx_face is None:
                crop_x = 0.5
                note("  no face found — framing centred, which may be wrong")
            else:
                # The 9:16 window is (h/w)*(9/16) of the source WIDTH — not 9/16,
                # which is the aspect ratio, not a fraction of anything here.
                size = probe_size(src) or (16, 9)
                cw = min(1.0, (size[1] / size[0]) * (9 / 16))
                span = max(1e-6, 1 - cw)
                crop_x = min(1.0, max(0.0, (fx_face - cw / 2) / span))
                note(f"  face at x={fx_face:.3f} → crop_x={crop_x:.3f}")
        crop_x = float(crop_x)

        made_here = []
        for fmt in c["formats"]:
            w, h, frame = framing(fmt, crop_x)
            dest = outdir / (f"{i:02d}-{slug}.mp4" if fmt == c["formats"][0]
                             else f"{i:02d}-{slug}-{fmt}.mp4")
            vf = frame
            overlay_ass = None
            fx = list(clip.get("effects") or [])
            # "icon" used to be its own effect and is the same thing as a
            # keyword that carries a glyph. Accept both spellings; keep one.
            legacy = [e for e in fx if e.get("type") == "icon"]
            fx = [e for e in fx if e.get("type") != "icon"]
            if c["push_in"] or any(e.get("type") in ("punch", "pull") for e in fx):
                # A slow push toward the speaker. A locked-off talking head goes
                # dead after ten seconds; a drift this small is not noticed, only
                # felt. zoompan wants an fps and an output size or it guesses.
                expr = zoom_expr(fx, end - start, c["push_in"], FPS)
                vf += (f",zoompan=z='max(1,min({expr},1.35))'"
                       f":d=1:x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)'"
                       f":s={w}x{h}:fps={FPS}")
            # Work the pip out first: the caption layer has to know where the
            # frame lands before it can place a panel clear of it.
            frames = [dict(e, _a=float(e.get("from", 0)) - start,
                              _b=float(e.get("to", 0)) - start)
                      for e in fx if e.get("type") == "frame"]
            graph, extra, pipbox = (pip_graph(frames, w, h, outdir)
                                    if frames else (None, [], None))
            if captions:
                sub = outdir / f".{i:02d}-{fmt}.ass"
                kws = clip.get("keywords")
                if legacy:
                    kws = (kws or []) + [{"text": e.get("text", ""),
                                          "at": e.get("at"), "icon": e.get("name")}
                                         for e in legacy]
                if kws is None:
                    # Only invent keywords when the agent named no graphics at
                    # all; otherwise the two layers say the same thing twice.
                    kws = [] if fx else pick_keywords(ws, start, end)
                if caption_ass(ws, start, end, sub, w, h, keywords=kws, face=face, pip=pipbox,
                               effects=[e for e in fx
                                        if e.get("type") not in ("punch", "pull")]):
                    # Applied LAST, after the frame composite. Burned in before
                    # it, the graphics get shrunk into the card along with the
                    # picture — which is exactly the space they were meant to
                    # stay out of.
                    overlay_ass = f"ass={sub}:fontsdir={ASSETS}"
            overlay_ass = overlay_ass if captions else None
            enc = ["-c:v", "libx264", "-preset", "medium", "-crf", "20",
                   "-c:a", "aac", "-b:a", "160k", "-movflags", "+faststart"]
            head = [ffbin(), "-nostdin", "-y", "-ss", f"{start}", "-to", f"{end}",
                    "-i", str(src)]

            if graph:
                # -t on the OUTPUT, not just -to on the input: the looped mask
                # images never end, so without it the graph keeps producing
                # frames long after the video has run out.
                tail = f";[vout]{overlay_ass}[vfin]" if overlay_ass else ""
                out_label = "[vfin]" if overlay_ass else "[vout]"
                cmd = head + extra + [
                    "-filter_complex", f"[0:v]{vf}[v];{graph}{tail}",
                    "-map", out_label, "-map", "0:a?",
                    "-t", f"{end - start:.3f}"] + enc + [str(dest)]
            else:
                full = vf + (f",{overlay_ass}" if overlay_ass else "")
                cmd = head + ["-vf", full] + enc + [str(dest)]
            subprocess.run(cmd, check=True, capture_output=True)
            made_here.append({"format": fmt, "file": str(dest)})

        # A thumbnail from the clip itself: a frame a third of the way in, where
        # the speaker is settled and a keyword is usually on screen. Authentic,
        # matches the content, and never looks AI-made.
        thumb = outdir / f"{i:02d}-{slug}.jpg"
        first = made_here[0]["file"] if made_here else None
        if first:
            at = max(1.0, (end - start) * 0.34)
            try:
                subprocess.run([ffbin(), "-nostdin", "-v", "error", "-y",
                                "-ss", f"{at}", "-i", first, "-frames:v", "1",
                                "-q:v", "2", str(thumb)],
                               check=True, capture_output=True, timeout=120)
            except Exception:
                thumb = None
        made.append({"title": clip.get("title"), "topic": clip.get("topic"),
                     "kind": clip.get("kind"), "start": round(start, 1),
                     "seconds": round(end - start, 1), "renders": made_here,
                     "thumbnail": str(thumb) if thumb else None})

    learned = fold_topics(src.stem, plan["topics"]) if plan.get("topics") else None
    note("done")
    return {"cut": len(made), "formats": c["formats"], "index": learned,
            "captions": captions, "clips": made, "folder": str(outdir)}


# --------------------------------------------------------------------------
# transcript / index — what the agent reads and writes back
# --------------------------------------------------------------------------

INDEX = HOME / "topics.json"


def transcript():
    """The newest transcript, line by line with a timestamp on each.

    Kept at Whisper's own granularity on purpose: the agent segments topics by
    reading, but it places `hook_at` on one specific sentence, and no coarser
    index can tell it where that sentence starts."""
    c, st = config(), load(STATE, {})
    seen = st.get("seen", {})
    if not seen:
        return {"error": "nothing transcribed yet"}
    src, meta = max(seen.items(), key=lambda kv: kv[1]["at"])
    work = Path(meta["work"])
    j = work / "transcript.json"
    if not j.exists():
        return {"error": f"transcript missing at {j}"}

    return {"source": Path(src).stem, "duration_s": probe_duration(Path(src)),
            "lines": to_lines(words(work))}


def words(work):
    """[(t, word)] straight from the word-level transcript."""
    raw = json.loads((work / "transcript.json").read_text())
    out = []
    for cue in raw.get("transcription", raw.get("segments", [])):
        off = cue.get("offsets") or {}
        t = (off.get("from", 0) / 1000.0) if off else to_seconds(cue)
        w = (cue.get("text") or "").strip()
        if w:
            out.append((round(t, 2), w))
    return out


def to_lines(ws, max_seconds=15):
    """Words regrouped into readable lines, broken on sentence ends.

    The agent reads these to segment topics; it names the hook by quoting from
    them, and `cut` snaps back to the word. Both views, one transcription."""
    lines, cur = [], None
    for t, w in ws:
        if cur is None:
            cur = {"t": t, "text": w}
        else:
            cur["text"] += " " + w
        if w.endswith((".", "?", "!")) or t - cur["t"] >= max_seconds:
            lines.append(cur); cur = None
    if cur:
        lines.append(cur)
    return lines


def to_seconds(cue):
    v = cue.get("start", 0)
    if isinstance(v, (int, float)):
        return float(v)
    h, m, rest = str(v).split(":")
    return int(h) * 3600 + int(m) * 60 + float(rest.replace(",", "."))


def index():
    """The owner's topic index, accumulated across every recording.

    This is the thing a per-upload clipping tool structurally cannot have: it
    knows the whole library, so a topic that comes back in a later episode joins
    the one that is already there instead of starting over."""
    return load(INDEX, {"topics": {}})


def fold_topics(src, topics):
    """Fold one recording's topics and moments into the owner's index."""
    idx = index()
    for t in topics or []:
        slot = idx["topics"].setdefault(t["topic"], {"occurrences": []})
        slot["occurrences"] = [o for o in slot["occurrences"] if o.get("source") != src]
        slot["occurrences"].append({"source": src, "range": t.get("range"),
                                    "moments": t.get("moments", []), "at": time.time()})
    save(INDEX, idx)
    return {"topics_known": len(idx["topics"]),
            "revisited": sorted(k for k, v in idx["topics"].items()
                                if len({o["source"] for o in v["occurrences"]}) > 1)}


def remember():
    """Fold ~/.dailies/learn.json into the index.

    Kept for the case where the agent wants to record what it found without
    cutting anything. The normal flow does not need it: `plan.json` carries
    `topics` and `cut` folds them in — one file and one prompt fewer for the
    owner on first use.
    """
    f = HOME / "learn.json"
    if not f.exists():
        return {"error": "no learn.json", "expected": str(f)}
    incoming = json.loads(f.read_text())
    return fold_topics(incoming["source"], incoming.get("topics", []))


def archive():
    """Put the finished recording away and say where everything went.

    The intake folder is an inbox: a recording that has been cut should leave
    it, marked, so that what remains is only what still needs work. Nothing is
    deleted — the file moves and keeps its name plus a dated marker."""
    c, st = config(), load(STATE, {})
    seen = st.get("seen", {})
    if not seen:
        return {"error": "nothing has been transcribed yet"}
    src_path, meta = max(seen.items(), key=lambda kv: kv[1]["at"])
    src = Path(src_path)
    if not src.exists():
        return {"archived": None, "reason": "already moved", "was": str(src)}

    dest_dir = Path(c["archive"]); dest_dir.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y-%m-%d")
    dest = dest_dir / f"{src.stem} [{c['done_marker']} {stamp}]{src.suffix}"
    n = 1
    while dest.exists():
        n += 1
        dest = dest_dir / f"{src.stem} [{c['done_marker']} {stamp} {n}]{src.suffix}"
    src.rename(dest)

    clips = Path(c["delivery"]) / src.stem
    made = sorted(f.name for f in clips.glob("*.mp4")) if clips.is_dir() else []
    st.setdefault("seen", {}).pop(src_path, None)
    st["seen"][str(dest)] = {**meta, "archived": time.time()}
    save(STATE, st)
    return {"archived": dest.name, "moved_to": str(dest_dir),
            "clips": made, "clips_in": str(clips)}


# --------------------------------------------------------------------------
# publishing
#
# The upload itself is browser work: the agent drives YouTube Studio through
# Latch with the owner's own session, so there is no OAuth app to register and
# nothing for an installer to configure. plowcut's job is to say what is ready,
# and to remember what went out.
# --------------------------------------------------------------------------

PUBLISHED = HOME / "published.json"


def pending():
    """Clips that exist on disk and have not been published yet."""
    c = config()
    done = load(PUBLISHED, {})
    out = []
    root = Path(c["delivery"])
    if not root.is_dir():
        return {"pending": [], "reason": f"no delivery folder at {root}"}
    for folder in sorted(root.iterdir()):
        if not folder.is_dir():
            continue
        for f in sorted(folder.glob("*.mp4")):
            if str(f) in done:
                continue
            out.append({"file": str(f), "recording": folder.name,
                        "format": "horizontal" if f.stem.endswith("-horizontal")
                                  else "vertical",
                        "seconds": probe_duration(f)})
    return {"pending": out, "already_published": len(done)}


def publish():
    """Record what the agent just put online, from ~/.dailies/publish.json.

    A file, not arguments — same reason as everywhere else. The agent writes
    what it published and where, and this folds it into the owner's history so
    that a later run can ask how it did.

    publish.json: {"file": "...", "url": "...", "title": "...",
                   "description": "...", "tags": [...], "platform": "youtube"}
    """
    f = HOME / "publish.json"
    if not f.exists():
        return {"error": "no publish.json", "expected": str(f)}
    rec = json.loads(f.read_text())
    if not rec.get("file") or not rec.get("url"):
        return {"error": "publish.json needs at least file and url"}
    done = load(PUBLISHED, {})
    done[rec["file"]] = {**rec, "at": time.time()}
    save(PUBLISHED, done)

    # Tie it back to the topic it came from, so performance can teach the next
    # cut rather than being a number nobody reads.
    idx, stem = index(), Path(rec["file"]).parent.name
    for topic, v in idx.get("topics", {}).items():
        for occ in v["occurrences"]:
            if occ.get("source") == stem:
                occ.setdefault("published", []).append(
                    {"url": rec["url"], "title": rec.get("title"), "at": time.time()})
    save(INDEX, idx)
    return {"recorded": rec["url"], "title": rec.get("title"),
            "total_published": len(done)}


def performance():
    """What has been published, and whatever view counts we have been told.

    Counts arrive from the agent reading YouTube Studio through Latch; nothing
    is estimated here. A clip with no reading reports none rather than a guess.
    """
    done = load(PUBLISHED, {})
    rows = []
    for f, r in sorted(done.items(), key=lambda kv: -kv[1].get("at", 0)):
        rows.append({"title": r.get("title"), "url": r.get("url"),
                     "published_at": time.strftime("%Y-%m-%d",
                                                   time.localtime(r.get("at", 0))),
                     "views": r.get("views"),
                     "measured_at": r.get("views_at")})
    known = [r for r in rows if r["views"] is not None]
    return {"published": rows,
            "with_view_data": len(known),
            "note": None if known else
            "no view counts recorded yet — do not guess at performance"}


def search():
    """Find where the owner said something, across everything ever transcribed.

    The index knows topics; this knows words. A question like "where did I talk
    about my kids" is answered from the transcripts themselves, so it works on
    things that were never cut and on phrasing no topic name would carry.

    query.json: {"q": "filhos", "limit": 6}
    """
    f = HOME / "query.json"
    if not f.exists():
        return {"error": "no query.json", "expected": str(f)}
    spec = json.loads(f.read_text())
    q = norm(str(spec.get("q", "")))
    if not q:
        return {"error": "query.json needs a q"}
    terms = [t for t in q.split() if len(t) > 2]
    limit = int(spec.get("limit", 6))

    st, hits = load(STATE, {}), []
    for src, meta in st.get("seen", {}).items():
        work = Path(meta.get("work", ""))
        if not (work / "transcript.json").exists():
            continue
        ws = words(work)
        if not ws:
            continue
        # Score a rolling window so a passage that circles the subject beats a
        # single stray mention of it.
        span, stem = 24, Path(src).stem
        for i in range(0, len(ws), 6):
            chunk = ws[i:i + span]
            text = " ".join(w for _, w in chunk)
            flat = norm(text)
            score = sum(flat.count(t) for t in terms)
            if not score:
                continue
            hits.append({"source": stem, "at": chunk[0][0], "score": score,
                         "text": text.strip()})
    if not hits:
        return {"q": spec.get("q"), "found": 0,
                "searched": len(st.get("seen", {})),
                "note": "nothing on that — say so rather than reaching"}

    # Keep the best window per neighbourhood, not every overlapping one.
    hits.sort(key=lambda h: (-h["score"], h["at"]))
    kept = []
    for h in hits:
        if any(k["source"] == h["source"] and abs(k["at"] - h["at"]) < 45
               for k in kept):
            continue
        kept.append(h)
        if len(kept) >= limit:
            break

    # Say which of these already became something, so the agent can offer the
    # clip instead of offering to make one that exists.
    pub = load(PUBLISHED, {})
    for h in kept:
        h["published"] = [
            {"title": r.get("title"), "url": r.get("url")}
            for fpath, r in pub.items() if Path(fpath).parent.name == h["source"]]
    return {"q": spec.get("q"), "found": len(kept),
            "searched": len(st.get("seen", {})), "hits": kept}


def _yt(cmd):
    """Delegate to yt_upload.py — the YouTube Data API side, kept separate so
    plowcut stays import-free and the OAuth details live in one place."""
    here = Path(__file__).resolve().parent
    for cand in (here / "yt_upload.py", HOME / "bin" / "yt_upload.py"):
        if cand.exists():
            r = subprocess.run([sys.executable, str(cand), cmd],
                               capture_output=True, text=True, timeout=1800)
            try:
                return json.loads(r.stdout or "{}")
            except Exception:
                return {"error": "yt_upload gave no JSON",
                        "stderr": (r.stderr or "")[-300:]}
    return {"error": "yt_upload.py not found next to plowcut"}


def yt_connect():
    """Start the YouTube device flow. Returns the code to text the owner."""
    return _yt("connect")


def yt_poll():
    """After the owner approves, exchange for the stored token."""
    return _yt("poll")


def yt_status():
    return _yt("status")


def yt_stats():
    """A read-only snapshot of the owner's YouTube channel."""
    return _yt("stats")


def yt_upload():
    """Upload the clip named in ~/.dailies/publish-plan.json to YouTube.

    No browser, no file picker: the Data API takes the bytes directly. Lands
    private while the app is unverified — the owner flips it public, which is
    also the last consent we want them to have. The title is numbered #1, #2,
    ... in publish order, so a channel of clips stays in sequence."""
    plan_path = HOME / "publish-plan.json"
    try:
        plan = json.loads(plan_path.read_text())
    except Exception:
        return {"error": "no publish-plan.json", "expected": str(plan_path)}
    # Next number = how many have gone up before, plus one. Stamped on the title
    # unless the plan already carries a #N.
    n = len(load(PUBLISHED, {})) + 1
    title = str(plan.get("title", "")).rstrip()
    import re as _re
    changed = False
    if not _re.search(r"#\d+\s*$", title):
        plan["title"] = f"{title} #{n}"
        changed = True
    # Never let an upload go up with YouTube's auto-frame: attach the poster
    # cut() wrote beside the clip (<stem>.jpg), or, if it is missing, a frame
    # grabbed here. The channel must be verified for the API to accept it;
    # yt_upload.py degrades cleanly and says so when it is not.
    if not plan.get("thumbnail"):
        cand = Path(plan["file"]).with_suffix(".jpg")
        if not cand.exists():
            try:
                subprocess.run([ffbin(), "-nostdin", "-v", "error", "-y",
                                "-ss", "1", "-i", plan["file"], "-frames:v", "1",
                                "-q:v", "2", str(cand)],
                               check=True, capture_output=True, timeout=120)
            except Exception:
                cand = None
        if cand and Path(cand).exists():
            plan["thumbnail"] = str(cand)
            changed = True
    if changed:
        plan_path.write_text(json.dumps(plan, ensure_ascii=False, indent=2))
    r = _yt("upload")
    if r.get("uploaded"):
        # Record it the same way a manual publish would, tying the URL to the
        # topic the clip came from.
        try:
            plan = json.loads((HOME / "publish-plan.json").read_text())
            done = load(PUBLISHED, {})
            done[plan["file"]] = {"url": r["url"], "title": plan.get("title"),
                                  "description": plan.get("description"),
                                  "tags": plan.get("tags", []), "platform": "youtube",
                                  "privacy": r.get("privacy"), "at": time.time()}
            save(PUBLISHED, done)
            idx, stem = index(), Path(plan["file"]).parent.name
            for _t, v in idx.get("topics", {}).items():
                for occ in v["occurrences"]:
                    if occ.get("source") == stem:
                        occ.setdefault("published", []).append(
                            {"url": r["url"], "title": plan.get("title"), "at": time.time()})
            save(INDEX, idx)
        except Exception:
            pass
    return r


def status():
    """What is here and what is missing, in the order it would break.

    Written so the agent can tell the owner exactly what to do next instead of
    reporting a failure and stopping: each missing piece names its own fix."""
    c, st = config(), load(STATE, {})
    ff = ffbin()
    checks = []

    def need(name, ok, why, fix):
        checks.append({"name": name, "ok": bool(ok), "why": why,
                       **({} if ok else {"fix": fix})})

    need("ffmpeg", shutil.which(ff) or Path(ff).exists(),
         "cutting and encoding", "brew install ffmpeg-full")
    need("ffmpeg can draw text", can_caption(),
         "captions, icons, panels — all of the graphics",
         "brew install ffmpeg-full (the plain formula has no libass)")
    py = venv_python()
    has_py = bool(py) and subprocess.run(
        [py, "-c", "import faster_whisper"], capture_output=True).returncode == 0
    need("transcription", shutil.which("whisper-cli") or has_py,
         "turning speech into the text everything else is chosen from",
         "run mac/install.sh (whisper.cpp), or use the container image")
    if shutil.which("whisper-cli"):
        need("whisper model", Path(c["model"]).exists(),
             "the weights whisper.cpp reads", "run mac/install.sh")
    need("icon font", (ASSETS / "icons.ttf").exists(),
         "icons in cards and keywords", "run mac/install.sh")
    need("display fonts", (ASSETS / "Anton.ttf").exists(),
         "typography — falls back to a system face", "run mac/install.sh")
    Path(c["intake"]).mkdir(parents=True, exist_ok=True)

    missing = [k["name"] for k in checks
               if not k["ok"] and not k.get("optional")]
    return {"ready": not missing, "missing": missing, "checks": checks,
            "where": "container" if ASSETS.as_posix().startswith("/opt") else "mac",
            "intake": c["intake"], "delivery": c["delivery"],
            "archive": c["archive"], "language": c["language"],
            "already_handled": len(st.get("seen", {}))}


CMDS = {"fetch": fetch, "ready": ready, "transcribe": transcribe,
        "yt-connect": yt_connect, "yt-poll": yt_poll, "yt-status": yt_status,
        "yt-upload": yt_upload, "yt-stats": yt_stats,
        "transcript": transcript,
        "index": index, "remember": remember, "search": search, "cut": cut, "archive": archive,
        "pending": pending, "publish": publish, "performance": performance,
        "status": status}

if __name__ == "__main__":
    if len(sys.argv) != 2 or sys.argv[1] not in CMDS:
        print(json.dumps({"error": "usage: plowcut {fetch|ready|transcribe|transcript|index|remember|search|cut|archive|pending|publish|performance|yt-connect|yt-poll|yt-upload|yt-status|yt-stats|status}"}))
        sys.exit(2)
    try:
        print(json.dumps(CMDS[sys.argv[1]](), indent=2))
    except subprocess.CalledProcessError as e:
        err = e.stderr or ""
        if isinstance(err, bytes):
            err = err.decode("utf8", "replace")
        print(json.dumps({"error": "command failed", "stderr": err[-800:]}))
        sys.exit(1)
