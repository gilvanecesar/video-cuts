#!/bin/sh
# Report this agent's token usage to the Agent Index, hourly.
#
# There is no switch. The reporter is in this image because someone put it here,
# and that is the decision. A flag would ask again, in a second place that can
# disagree with the Dockerfile.

PATH=/command:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH

# Written by first boot from the credential the host dropped in, root 0600 —
# read here, before dropping to the agent's uid.
PLOW_AGENT_TOKEN=$(cat /run/s6/container_environment/PLOW_AGENT_TOKEN 2>/dev/null || true)
AGENT_ID=$(cat /run/s6/container_environment/AGENT_ID 2>/dev/null || true)
export AGENT_ID

# Fixed, not overridable. A second way to name the home only creates the case
# where the reporter and the agent disagree about whose usage store is whose.
HERMES_HOME=/var/lib/hermes
export HERMES_HOME

if [ -z "$AGENT_ID" ]; then
  echo "agent-index: no AGENT_ID in this container's environment, so there is" >&2
  echo "nothing to report FOR. Set it in compose.yml. Standing down." >&2
  exec sleep 86400
fi

PY=/opt/hermes/.venv/bin/python3
CLIENT=/opt/plow/agent-index-client.py
as_agent() { /command/s6-setuidgid hermes env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" "$@"; }

while :; do
  # The client owns the question of whether this install is registered, and
  # where it keeps that state. Its exit codes:
  #   0 registered   3 not registered   2 state exists but is unreadable
  #
  # 2 is not 3. Registering over state the client could not read mints against a
  # new install id and strands every hour this install already published — so
  # that hour is skipped instead. stdout is dropped; it says the same thing
  # every hour. stderr is kept: on 2 it names the file it could not read.
  as_agent "$PY" "$CLIENT" status >/dev/null
  case $? in
    0) ;;
    3)
      as_agent env AGENT_ID="$AGENT_ID" PLOW_AGENT_TOKEN="$PLOW_AGENT_TOKEN" \
        "$PY" "$CLIENT" --register --agent "$AGENT_ID" >/dev/null || {
          echo "agent-index: no index key this hour, not reporting" >&2
          /bin/sleep 3600; continue; }
      ;;
    *)
      echo "agent-index: could not read this install's state (above);" >&2
      echo "standing off rather than registering over it." >&2
      /bin/sleep 3600; continue
      ;;
  esac

  as_agent env AGENT_ID="$AGENT_ID" "$PY" "$CLIENT" --agent "$AGENT_ID" >/dev/null \
    || echo "agent-index: this hour's report did not go through" >&2
  /bin/sleep 3600
done
